{
  "manifest_version": 3,
  "name": "BrasOS",
  "version": "1.0.0",
  "description": "Adds a web app you install in this browser to BrasOS.",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Add this site to BrasOS" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "host_permissions": ["http://localhost/*"]
}

{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@brasos/audit": ["packages/audit/src/audit.ts"],
      "@brasos/sdk": ["packages/sdk/src/index.ts"],
      "@brasos/registry": ["packages/registry/src/index.ts"],
      "@brasos/agent": ["packages/agent/src/index.ts"],
      "@brasos/ui": ["packages/ui/src/index.ts"],
      "@brasos/ui/*": ["packages/ui/src/*"],
      "@brasos/files": ["packages/files/src/index.ts"],
      "@brasos/setup": ["packages/setup/src/index.ts"],
      "@brasos/system": ["packages/system/src/index.ts"],
      "@brasos/native": ["packages/native/src/index.ts"],
      "@brasos/db": ["packages/db/src/index.ts"],
      "@brasos/docs": ["packages/docs/src/index.ts"],
      "@brasos/web-gateway": ["packages/web-gateway/src/index.ts"],
      "@brasos/hardened": ["packages/hardened/src/index.ts"],
      "@brasos/host/*": ["packages/host/src/*"]
    }
  }
}
